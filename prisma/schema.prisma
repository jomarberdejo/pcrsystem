generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OperationType {
  EMERGENCY
  TRANSPORT
}

enum Team {
  CHARLIE
  BRAVO
  ALPHA
}

enum Status {
  ACTIVE
  ARCHIVED
}

model Personnel {
  id              String        @id @default(uuid()) @db.Uuid
  name            String
  role            PersonnelRole
  customRole      String?
  team            Team?
  status          Status        @default(ACTIVE)
  archivedAt      String?
  recordsAsDriver Record[]      @relation("DriverRecords")
  recordsAsCrew   RecordCrew[]  @relation("CrewRecords")
}

enum PersonnelRole {
  DRIVER
  CREW
  BOTH
}

model Record {
  id                String        @id @default(uuid()) @db.Uuid
  date              DateTime
  timeCalled        String?
  timeDispatched    String?
  timeAtScene       String?
  timeTransport     String?
  timeEndorsed      String?
  timeArrivedAt     String?
  typeOfIncident    String?
  placeOfIncident   String?
  receivingFacility String?
  typeOfConduction  String?
  vehiclesInvolved  String        @default("None")
  chiefComplaint    String
  noOfCasualty      String
  remarks           String
  vehicleUsed       String?
  documentation     Json?         @db.JsonB
  operationType     OperationType
  ambulanceDriverId String?       @db.Uuid
  ambulanceDriver   Personnel?    @relation("DriverRecords", fields: [ambulanceDriverId], references: [id], onDelete: SetNull)
  ambulanceCrews    RecordCrew[]
  createdById       String?       @db.Uuid
  createdBy         Admin?        @relation("CreatedRecords", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById       String?       @db.Uuid
  updatedBy         Admin?        @relation("UpdatedRecords", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime?     @updatedAt

  auditLogs AuditLog[] @relation("AuditLogRecord")
}

model RecordCrew {
  id       String    @id @default(uuid()) @db.Uuid
  recordId String    @db.Uuid
  crewId   String    @db.Uuid
  record   Record    @relation(fields: [recordId], references: [id], onDelete: Cascade)
  crew     Personnel @relation("CrewRecords", fields: [crewId], references: [id], onDelete: Cascade)

  @@unique([recordId, crewId])
}

enum AdminRole {
  MDRRMO_ADMIN
  REGULAR_ADMIN
}

model Admin {
  id             String     @id @default(uuid()) @db.Uuid
  username       String     @unique
  password       String
  role           AdminRole  @default(REGULAR_ADMIN)
  dateCreated    DateTime   @default(now())
  sessions       Session[]
  createdRecords Record[]   @relation("CreatedRecords")
  updatedRecords Record[]   @relation("UpdatedRecords")
  auditLogs      AuditLog[] @relation("PerformedByAdmin")
}

model AuditLog {
  id               String   @id @default(uuid()) @db.Uuid
  action           String
  performedBy      String   @db.Uuid
  performedByAdmin Admin    @relation("PerformedByAdmin", fields: [performedBy], references: [id])
  timestamp        DateTime @default(now())
  recordId         String?  @db.Uuid
  record           Record?  @relation("AuditLogRecord", fields: [recordId], references: [id], onDelete: SetNull)
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  user         Admin    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken String   @unique
  expires      DateTime
  createdAt    DateTime @default(now())
}
